{
  "name": "cura-cafe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/build-static.ts",
    "start": "next start",
    "lint": "eslint .",
    "test": "npm run test:unit && playwright test",
    "test:build": "GITHUB_PAGES=true npm run build && npm test",
    "validate:content": "tsx scripts/validate-content.ts",
    "prebuild": "npm run validate:content",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:scenarios": "tsx scripts/test-editorial-scenarios.ts",
    "postbuild": "tsx scripts/finalize-export.ts",
    "screenshots": "tsx scripts/capture-presentation.ts",
    "present": "node scripts/serve-export.mjs",
    "ops": "tsx scripts/ops.ts",
    "build:server": "npm run validate:content && CURA_TARGET=server next build",
    "start:server": "CURA_TARGET=server next start",
    "test:commerce": "tsx scripts/test-commerce.ts",
    "eval:barista": "tsx scripts/eval-barista.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@electric-sql/pglite": "^0.3.16",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "next": "^15.5.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.4.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "yaml": "^2.9.1"
  }
}
